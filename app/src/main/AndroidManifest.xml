<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application android:allowBackup="false" android:fullBackupContent="false" android:label="@string/app_name"
        android:dataExtractionRules="@xml/data_extraction_rules" tools:targetApi="31"
        android:icon="@mipmap/ic_type" android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:name=".ime.VoicePermissionActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".app.MainActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- Preserve existing launcher shortcuts and IME settings intents. -->
        <activity-alias android:name="dev.keyloom.keyboard.MainActivity" android:targetActivity=".app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service android:name="dev.keyloom.keyboard.KeyloomIme" android:exported="true"
            android:label="@string/app_name" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
