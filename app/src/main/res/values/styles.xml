<resources>
    <color name="icon_background">#000000</color>
    <string name="app_name" translatable="false">Nothing Type</string>
    <string name="subtype" translatable="false">Nothing Type · %s</string>
    <string name="setting_value" translatable="false">%1$s · \u2066%2$d %3$s\u2069</string>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F2F2F2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
    <style name="TypeDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F2F2F2</item>
        <item name="android:colorControlNormal">#A9A9A9</item>
        <item name="android:colorControlHighlight">#26FFFFFF</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowAnimationStyle">@style/TypeDialogAnimation</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/TypeDialogPrimaryAction</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TypeDialogAction</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TypeDialogAction</item>
        <item name="android:backgroundDimAmount">0.65</item>
    </style>
    <style name="TypeDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    <style name="TypeDialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_action_secondary</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="TypeDialogPrimaryAction" parent="TypeDialogAction">
        <item name="android:background">@drawable/dialog_action_primary</item>
        <item name="android:textColor">#1C1C1C</item>
    </style>
</resources>
